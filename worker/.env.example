# Variables del worker (motor de agentes). Copia este archivo a worker/.env.local y llena los valores
# desde el gestor de contraseñas (guía 2, sección 10). En la VM van como variables del servicio (T-07).

# Supabase: en local, http://localhost:55321 y la secret key de «supabase status».
SUPABASE_URL=http://localhost:55321
SUPABASE_SECRET_KEY=

# Gemini (entrada «Google · Gemini API key», campo «Clave API»).
GEMINI_API_KEY=

# Claude Code en modo no interactivo (entrada «Claude · token worker»).
CLAUDE_CODE_OAUTH_TOKEN=

# Ruta al JSON del cliente OAuth de escritorio de Google, fuera del repositorio.
# Los archivos .env no expanden «~»: el worker debe resolverlo con os.path.expanduser.
GOOGLE_OAUTH_CLIENT_FILE=~/.local/share/agora-privado/google/client_secret_agora-worker.json
