# Variables de la web. Copia este archivo a apps/web/.env.local y llena los valores (guía 2, sección 10).
# En local salen de «supabase status»; contra la nube, de la entrada «Supabase · agora-dev» del gestor.

# Públicas: el prefijo NEXT_PUBLIC_ las incluye en el código del navegador.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo de servidor: ignora RLS. Nunca lleva el prefijo NEXT_PUBLIC_ y solo se usa en src/server/.
SUPABASE_SECRET_KEY=
