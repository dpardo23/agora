*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
apps/worker/salidas/

# =============================================================================
# 9. Servicios locales (Supabase CLI, Docker, n8n)
