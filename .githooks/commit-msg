#!/bin/sh
# Rechaza commits que atribuyan autoría a herramientas de IA (CONTRIBUTING.md, sección 2, regla 6).
# Se activa una vez por clon con: git config core.hooksPath .githooks
if grep -Eiq '^(co-authored-by|claude-session|generated-by):|noreply@anthropic\.com|claude\.ai/code' "$1"; then
  echo "commit-msg: el mensaje atribuye coautoría a una herramienta de IA. Quita esa línea." >&2
  exit 1
fi
