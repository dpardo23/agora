# Formato común para cualquier editor (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python sigue PEP 8 (lo aplica ruff).
[*.py]
indent_size = 4

# En Markdown, dos espacios al final de línea son un salto de línea.
[*.md]
trim_trailing_whitespace = false

# Make exige tabuladores.
[Makefile]
indent_style = tab
